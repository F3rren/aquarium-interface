{
  "name": "aquarium-interface",
  "version": "1.0.0",
  "description": "![Flutter](https://img.shields.io/badge/flutter-3.x-blue.svg) ![Dart SDK](https://img.shields.io/badge/dart-^3.9.2-blue.svg) ![Status](https://img.shields.io/badge/status-active-success.svg) ![License: MIT](https://img.shields.io/badge/license-MIT-green.svg) ![Platforms](https://img.shields.io/badge/platforms-Android%20%7C%20iOS-lightgrey.svg)",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "api:generate": "openapi-generator-cli generate",
    "api:generate:available": "npm run api:generate:aquariums && npm run api:generate:inhabitants && npm run api:generate:species && npm run api:generate:parameters && npm run api:generate:manual-parameters && npm run api:generate:target-parameter",
    "api:generate:aquariums": "openapi-generator-cli generate --generator-key aquariums-service",
    "api:generate:inhabitants": "openapi-generator-cli generate --generator-key inhabitants-service",
    "api:generate:species": "openapi-generator-cli generate --generator-key species-service",
    "api:generate:maintenance": "openapi-generator-cli generate --generator-key maintenance-service",
    "api:generate:parameters": "openapi-generator-cli generate --generator-key parameters-service",
    "api:generate:manual-parameters": "openapi-generator-cli generate --generator-key manual-parameters-service",
    "api:generate:target-parameter": "openapi-generator-cli generate --generator-key target-parameter-service"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F3rren/aquarium-interface.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/F3rren/aquarium-interface/issues"
  },
  "homepage": "https://github.com/F3rren/aquarium-interface#readme",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.32.0"
  }
}
