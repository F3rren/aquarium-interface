# Backend API — ReefLife
# Copy this file to the appropriate .env.* variant and fill in real values.
# NEVER commit .env, .env.staging, or .env.prod — they are gitignored.
#
# .env or .env.dev  → local development (Android emulator: http://10.0.2.2:8080)
# .env.staging      → staging environment
# .env.prod         → production environment
#
# Build commands:
#   flutter run   --flavor dev     -t lib/main_dev.dart     --dart-define-from-file=.env
#   flutter run   --flavor staging -t lib/main_staging.dart --dart-define-from-file=.env.staging
#   flutter build appbundle --flavor prod -t lib/main_prod.dart --dart-define-from-file=.env.prod
API_HOST=https://your-alb-or-domain.example.com
API_PORT=443
