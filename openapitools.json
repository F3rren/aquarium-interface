{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.22.0",
    "generators": {
      "aquariums-service": {
        "generatorName": "dart",
        "inputSpec": "http://localhost:8081/v3/api-docs",
        "output": "lib/api/generated/aquariums_service",
        "additionalProperties": {
          "pubName": "aquariums_service",
          "pubVersion": "1.0.0",
          "pubDescription": "Generated Dart client for aquariums-service"
        }
      },
      "inhabitants-service": {
        "generatorName": "dart",
        "inputSpec": "http://localhost:8082/v3/api-docs",
        "output": "lib/api/generated/inhabitants_service",
        "additionalProperties": {
          "pubName": "inhabitants_service",
          "pubVersion": "1.0.0",
          "pubDescription": "Generated Dart client for inhabitants-service"
        }
      },
      "species-service": {
        "generatorName": "dart",
        "inputSpec": "http://localhost:8083/v3/api-docs",
        "output": "lib/api/generated/species_service",
        "additionalProperties": {
          "pubName": "species_service",
          "pubVersion": "1.0.0",
          "pubDescription": "Generated Dart client for species-service"
        }
      },
      "maintenance-service": {
        "generatorName": "dart",
        "inputSpec": "http://localhost:8084/v3/api-docs",
        "output": "lib/api/generated/maintenance_service",
        "skipValidateSpec": true,
        "additionalProperties": {
          "pubName": "maintenance_service",
          "pubVersion": "1.0.0",
          "pubDescription": "Generated Dart client for maintenance-service"
        }
      },
      "parameters-service": {
        "generatorName": "dart",
        "inputSpec": "http://localhost:8085/v3/api-docs",
        "output": "lib/api/generated/parameters_service",
        "additionalProperties": {
          "pubName": "parameters_service",
          "pubVersion": "1.0.0",
          "pubDescription": "Generated Dart client for parameters-service"
        }
      },
      "manual-parameters-service": {
        "generatorName": "dart",
        "inputSpec": "http://localhost:8086/v3/api-docs",
        "output": "lib/api/generated/manual_parameters_service",
        "additionalProperties": {
          "pubName": "manual_parameters_service",
          "pubVersion": "1.0.0",
          "pubDescription": "Generated Dart client for manual-parameters-service"
        }
      },
      "target-parameter-service": {
        "generatorName": "dart",
        "inputSpec": "http://localhost:8087/v3/api-docs",
        "output": "lib/api/generated/target_parameter_service",
        "additionalProperties": {
          "pubName": "target_parameter_service",
          "pubVersion": "1.0.0",
          "pubDescription": "Generated Dart client for target-parameter-service"
        }
      }
    }
  }
}
